<mvc:View
    controllerName="serviceapproval.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    displayBlock="true">

    <Page title="Service Sheet Approval">
        <content>

            <VBox class="sapUiContentPadding">

                <!-- INPUT SECTION -->
                <Panel
                    headerText="Service Sheet Approval"
                    class="sapUiResponsiveMargin">

                    <f:SimpleForm
                        editable="true"
                        layout="ResponsiveGridLayout"
                        labelSpanL="3"
                        labelSpanM="3"
                        labelSpanS="12"
                        columnsL="2"
                        columnsM="2"
                        columnsS="1">

                        <Label text="User"/>
                        <Input
                            id="idUser"
                            placeholder="Enter User ID"
                            width="300px"
                            />

                        <Label text="Service Sheet Number"/>
                        <Input
                            id="idSheet"
                            placeholder="Enter Service Number"
                            width="300px"
                            maxLength="10"
                            type="Text"
                            liveChange=".onSheetLiveChange"
                            submit=".onLoadDetails"/>

                    </f:SimpleForm>

                    <HBox
                        justifyContent="Center"
                        wrap="Wrap"
                        class="sapUiMediumMarginTop">

                        <Button
                            text="Details"
                            type="Emphasized"
                            press=".onLoadDetails"
                            icon="sap-icon://display"/>

                        <Button
                            text="Approve"
                            type="Accept"
                            press=".onApprove"
                            icon="sap-icon://accept"
                            class="sapUiSmallMarginBegin"
                            enabled="{ui>/detailsLoaded}"/>

                        <Button
                            text="Reject"
                            type="Reject"
                            press=".onReject"
                            icon="sap-icon://decline"
                            class="sapUiSmallMarginBegin"
                            enabled="{ui>/detailsLoaded}"/>

                        <!-- <Button
                            text="Refresh"
                            type="Transparent"
                            press=".onRefresh"
                            icon="sap-icon://refresh"
                            class="sapUiSmallMarginBegin"/> -->
                    </HBox>
                </Panel>

                <!-- SES ITEMS -->
                <Panel
                    headerText="Service Entry Items"
                    visible="{= ${items>/}.length > 0 }"
                    class="sapUiResponsiveMargin">

                    <Table
                        items="{items>/}"
                        growing="true"
                        growingScrollToLoad="true"
                        noDataText="No Service Entry Items Found">

                        <columns>
                            <Column>
                                <Text text="Line"/>
                            </Column>
                            <Column>
                                <Text text="Service No"/>
                            </Column>
                            <Column>
                                <Text text="Description"/>
                            </Column>
                            <Column hAlign="End">
                                <Text text="Quantity"/>
                            </Column>
                            <Column hAlign="End">
                                <Text text="Net Value"/>
                            </Column>
                            <Column hAlign="End">
                                <Text text="Gross Price"/>
                            </Column>
                            <Column>
                                <Text text="UOM"/>
                            </Column>
                        </columns>

                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{items>Line}"/>
                                    <Text text="{items>ServiceNo}"/>
                                    <Text text="{items>ShortText}"/>
                                    <Text text="{items>Quantity}"/>
                                    <Text text="{items>NetValue}"/>
                                    <Text text="{items>GrossPrice}"/>
                                    <Text text="{items>Uom}"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>

            </VBox>
        </content>
    </Page>
</mvc:View>
